# ===========================================================================
# Environment variables for iso-platform
# ===========================================================================
# Local development:  cp .env.example .env.local   then fill in the values.
# Production/Preview: set these in Vercel > Project > Settings > Environment
#                     Variables (Production AND Preview). A redeploy is needed
#                     after any change.
#
# NEVER commit real values. Only this example file is tracked by git.
#
# "Public" = the name starts with NEXT_PUBLIC_, so the value is bundled into
# the browser JavaScript and visible to anyone. Everything else is
# server-only and must stay secret.
# ===========================================================================

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical public URL of the site, no trailing slash (used for canonical
# links, Open Graph, sitemap, robots.txt).
# Optional. Public. Default: https://amqualitysystems.com
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Supabase (database + auth) - Supabase dashboard > Project Settings > API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://xxxxxxxx.supabase.co
# Required. Public.
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe in the browser; Row-Level Security
# (db/rls.sql) is what protects the data.
# Required. Public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. Bypasses Row-Level Security - never expose it.
# Used by the admin page, the BroRacks webhook and enrollment API routes.
# Required. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend (email) - https://resend.com/api-keys
# ---------------------------------------------------------------------------

# API key used to send all emails. Without it no email is sent.
# Required. Server-only.
RESEND_API_KEY=

# "From" address for client-facing emails (confirmations, auto-replies).
# Must be on a domain verified in Resend.
# Optional. Server-only. Default: info@amqualitysystems.com
RESEND_FROM=

# "From" address for internal staff alerts (new applications, payments).
# Optional. Server-only. Default: same as RESEND_FROM
RESEND_NOTIFICATIONS_FROM=

# Staff inbox that receives applications, enquiries and payment alerts.
# Optional (recommended). Server-only. Default: info@amqualitysystems.com
# (the public contact address), with a warning in the logs.
NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# BroRacks (Uganda Mobile Money: MTN + Airtel) - BroRacks dashboard
# See docs/broracks-cutover.md when switching accounts.
# ---------------------------------------------------------------------------

# Public key for the BroRacks collections API.
# Required for payments. Server-only (only ever sent from the server, never
# to the browser, despite the name).
BRORACKS_PUBLIC_KEY=

# Secret key for the BroRacks collections API.
# Required for payments. Server-only.
BRORACKS_SECRET_KEY=

# Webhook signing secret. Used to check that payment notifications sent to
# /api/webhooks/broracks really come from BroRacks. Without it every webhook
# is rejected and payments are never confirmed automatically.
# Required for payments. Server-only.
BRORACKS_WEBHOOK_SECRET=

# Webhook signing secret of the PREVIOUS BroRacks account. Set it only while
# switching accounts, so payments started on the old account can still be
# confirmed. Delete it about 48 hours after the switch.
# Optional. Server-only. Default: unset (only BRORACKS_WEBHOOK_SECRET accepted)
BRORACKS_WEBHOOK_SECRET_PREVIOUS=

# Base URL of the BroRacks API. Only change it if BroRacks tells you to.
# Optional. Server-only. Default: https://api.broracks.online
BRORACKS_API_URL=
